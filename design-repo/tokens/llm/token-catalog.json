{
  "$id": "tokens.llm.token-catalog",
  "version": "1.0.0",
  "description": "The curated, referenceable view of the token system \u2014 not the whole system. A generator references these names and never a raw literal. Keys mirror the real token files exactly so token-policy.json's categories resolve against something real.",
  "resolutionOrder": [
    "00-foundation",
    "themes/<mode>",
    "10-semantic",
    "20-component",
    "permitted local overrides (see tokens/llm/token-policy.json)",
    "responsive overrides (max-wf-* only)"
  ],
  "semantic": [
    "border.default",
    "border.formControl",
    "border.formError",
    "motion.drift",
    "motion.overlayClose",
    "motion.ui",
    "radius.card",
    "radius.control",
    "radius.pillFull",
    "radius.pillPrimary",
    "radius.pillSecondary",
    "radius.pillStat",
    "surface.accent",
    "surface.alt",
    "surface.card",
    "surface.inverse",
    "surface.overlay",
    "surface.page",
    "surface.quote",
    "text.body",
    "text.onInverse",
    "text.outsideRoot",
    "text.primary"
  ],
  "foundationCategories": {
    "color": "tokens/00-foundation/color.json",
    "typography": "tokens/00-foundation/typography.json",
    "radius": "tokens/00-foundation/radius.json",
    "spacing": "tokens/00-foundation/spacing.json",
    "border": "tokens/00-foundation/border.json",
    "breakpoint": "tokens/00-foundation/breakpoint.json",
    "elevation": "tokens/00-foundation/elevation.json",
    "iconSize": "tokens/00-foundation/icon-size.json",
    "motion": "tokens/00-foundation/motion.json",
    "interaction": "tokens/00-foundation/interaction.json"
  },
  "layout": "tokens/30-layout/layout.json",
  "themes": {
    "light": "tokens/themes/light.json"
  },
  "motionEasings": [
    "drift",
    "overlay-close",
    "ui-default"
  ],
  "motionDurations": [
    "drift-card-a",
    "drift-card-c",
    "drift-default",
    "hover-colors",
    "overlay-close",
    "overlay-open"
  ],
  "hardRules": [
    "Lengths stay in `em` wherever the source uses `em`; never convert em to px.",
    "`ch` values stay in `ch` \u2014 49ch is 580.714px on an 18.667px paragraph but 1981.52px on a 65.333px heading, so flattening it to px breaks the layout.",
    "The .marketing-root em engine (tokens/30-layout/layout.json) governs every length in the system."
  ]
}