{
  "$id": "extraction.section-dom-map",
  "version": "2.0.0",
  "description": "How extraction/measure_sections.mjs maps the built clone's rendered DOM onto each template's in-flow nodes (every node that is not chrome.*). One representative route per template: the tallest served route that renders the template's full node set. `units` is aligned 1:1 with the template's in-flow nodes in order.",
  "unitKinds": {
    "main": "a whole top-level child of <main> (a <section> or a leaf-divider band)",
    "kids": "an inclusive range of children of that section's single wrapper div",
    "part": "hero = the opening <section> from its top to the first block containing the display h2 (h2.font-headline); proof = from there to the section bottom",
    "chapters": "the unit is a prose container split at every H2 and H3 heading: one height per heading-bounded chapter / legal part (content before the first heading belongs to chapter 1)"
  },
  "slotRule": "A unit's height is the distance from its own top to the next unit's top inside the same <section> (the first unit starts at the section top, the last ends at the section bottom), so margins are attributed and the units partition the page.",
  "viewport": {
    "width": 1440,
    "height": 900
  },
